{
  "$schema": "../../../schema/sft.schema.json",

  "checkpoint_root": "$auto",
  "auto_resume": true,
  "seed_checkpoint_dir": "/dev/shm/flow-control/seed",
  "experiment_name": "flux_sft_demo",
  "max_checkpoints": 10,
  "validation_steps": 20,
  "validation_variants": ["ema"],
  "checkpoint_interval": 20,

  "gradient_checkpointing": true,
  "train_batch_size": 16,
  "train_steps": 200,

  "hsdp_shard_dim": 1,

  "model": {
    "arch": "flux1",
    "type": "base",
    "variants": {
      "default": { "type": "lora", "rank": 16, "alpha": 8 },
      "ema": { "type": "ema", "of": "default", "decay": 1.0, "warmup": "standard" }
    }
  },

  "train_predictor": "model",

  "validation_sampler": { "type": "grid", "steps": 20, "shift": "linear" },

  "processor": {
    "task": "t2i",
    "preset": "flux1"
  },

  "optimizer_config": {
    "class_name": "AdamW",
    "lr": 5e-4
  },

  "scheduler_config": {
    "class_name": "ConstantLR",
    "factor": 1.0
  },

  "dataset": {
    "type": "cache",
    "path": "./data/christian_boragine/flux1"
  },

  "validation_dataset": {
    "type": "cache",
    "path": "./data/christian_boragine/flux1_validation"
  },

  "launch": {
    "type": "sft",
    "devices": "all",
    "generate_dcp_seed": true
  }
}
