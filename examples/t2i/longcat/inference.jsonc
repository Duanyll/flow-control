{
  "$schema": "../../../schema/inference.schema.json",
  "report": {
    "path": "./demo/inference_longcat_t2i",
    "previews": true,
    "records": false
  },
  "hsdp_shard_dim": 1,
  "model": {
    "arch": "longcat",
    "type": "base"
  },
  "dataset": {
    "type": "cache",
    "path": "./demo/preprocess_longcat_t2i"
  },
  "sampler": {
    "steps": 50,
    "guidance": { "type": "cfg", "scale": 4.0, "renorm": true },
    "shift": {
      "type": "linear"
    }
  },
  "processor": {
    "task": "t2i",
    "preset": "longcat_image"
  },
  "launch": {
    "type": "inference",
    "devices": 4,
    "preprocess_config": "examples/t2i/longcat/preprocess.jsonc"
  }
}
