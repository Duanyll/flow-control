{
  "$schema": "../../../schema/inference.schema.json",
  "seed_checkpoint_dir": "./demo/seed/flux2_klein_base_4b",
  "report": {
    "path": "./demo/inference_flux2_klein_base_4b_t2i",
    "previews": true,
    "records": false
  },
  "hsdp_shard_dim": 1,
  "model": {
    "arch": "flux2",
    "type": "base",
    "hf_model": {
      "library": "diffusers",
      "class_name": "Flux2Transformer2DModel",
      "pretrained_model_id": "black-forest-labs/FLUX.2-klein-base-4B",
      "subfolder": "transformer",
      "dtype": "bfloat16"
    }
  },
  "dataset": {
    "type": "cache",
    "path": "./demo/preprocess_flux2_klein_4b_t2i"
  },
  "sampler": {
    "steps": 50,
    "guidance": { "type": "cfg", "scale": 3.5 },
    "shift": {
      "type": "flux2"
    }
  },
  "processor": {
    "task": "t2i",
    "preset": "flux2_klein_4b"
  },
  "launch": {
    "type": "inference",
    "devices": 4,
    "preprocess_config": "examples/t2i/flux2/klein_4b.preprocess.jsonc"
  }
}
