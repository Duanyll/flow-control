{
  "$schema": "../../../schema/inference.schema.json",
  "report": {
    "path": "./demo/inference_flux2_klein_9b_kv",
    "previews": true,
    "records": false
  },
  "hsdp_shard_dim": 1,
  "model": {
    "arch": "flux2",
    "type": "kv"
  },
  "dataset": {
    "type": "cache",
    "path": "./demo/preprocess_flux2_klein_9b_kv"
  },
  "sampler": {
    "seed": 0,
    "steps": 4,
    "shift": {
      "type": "flux2"
    }
  },
  "processor": {
    "task": "t2i",
    "preset": "flux2_klein_9b_kv"
  },
  "launch": {
    "type": "inference",
    "devices": 1,
    "preprocess_config": "examples/t2i/flux2/klein_9b_kv.preprocess.jsonc"
  }
}
