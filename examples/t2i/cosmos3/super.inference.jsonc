// Cosmos3-Super-Text2Image (64B) on 4 GPUs. 128 GB of bf16 weights, so it needs
// FSDP even for inference: 4x80 GB A800, or 4x H100/H200. The Text2Image expert's
// official guidance is 4.0 (the omni base models use 6.0).
{
  "$schema": "../../../schema/inference.schema.json",
  "report": {
    "path": "./demo/inference_cosmos3_super",
    "previews": true,
    "records": false
  },
  "hsdp_shard_dim": 4,
  "model": {
    "arch": "cosmos3",
    "type": "kv",
    "hf_model": {
      "library": "diffusers",
      "class_name": "Cosmos3OmniTransformer",
      "pretrained_model_id": "nvidia/Cosmos3-Super-Text2Image",
      "subfolder": "transformer",
      "dtype": "bfloat16"
    }
  },
  "dataset": {
    "type": "cache",
    "path": "./demo/preprocess_cosmos3_super"
  },
  "sampler": {
    "seed": 0,
    "steps": 35,
    "guidance": {
      "type": "cfg",
      "scale": 4.0
    },
    "solver": {
      "type": "flow_unipc",
      "order": 2
    },
    "custom_sigmas": [
      0.995025,
      0.994317,
      0.993493,
      0.992529,
      0.991401,
      0.990074,
      0.988511,
      0.986663,
      0.984472,
      0.981866,
      0.978755,
      0.975033,
      0.970563,
      0.965181,
      0.958682,
      0.950816,
      0.941273,
      0.929679,
      0.915581,
      0.898438,
      0.877622,
      0.852423,
      0.822073,
      0.785805,
      0.742945,
      0.693052,
      0.636105,
      0.572694,
      0.504181,
      0.432725,
      0.361117,
      0.292409,
      0.229421,
      0.174285,
      0.12816,
      0.0
    ]
  },
  "processor": {
    "task": "t2i",
    "preset": "cosmos3_super_t2i"
  },
  "launch": {
    "type": "inference",
    "devices": 4,
    "preprocess_config": "examples/t2i/cosmos3/super.preprocess.jsonc"
  }
}
