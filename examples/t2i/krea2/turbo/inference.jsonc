{
  "$schema": "../../../../schema/inference.schema.json",
  "report": {
    "path": "./demo/inference_krea2_turbo_t2i",
    "previews": true,
    "records": false
  },
  "hsdp_shard_dim": 1,
  "model": { "arch": "krea2", "type": "turbo" },
  "dataset": {
    "type": "cache",
    "path": "./demo/preprocess_krea2_turbo_t2i"
  },
  // Krea 2 Turbo is 8-step distilled and guidance-free: no cfg node (no negative
  // batch). Distilled path uses a fixed shift mu=1.15 -> constant shift exp(1.15)=3.158.
  "sampler": { "type": "grid", "steps": 8, "shift": 3.158 },
  "processor": {
    "task": "t2i",
    "preset": "krea2_turbo"
  },
  "launch": {
    "type": "inference",
    "devices": 1,
    "preprocess_config": "examples/t2i/krea2/turbo/preprocess.jsonc"
  }
}
