{
  "$schema": "../../../schema/inference.schema.json",
  "report": {
    "path": "./demo/inference_zimage_t2i",
    "previews": true,
    "records": false
  },
  "seed": 1024,
  "hsdp_shard_dim": 1,
  "model": { "arch": "zimage", "type": "base" },
  "dataset": {
    "type": "cache",
    "path": "./demo/preprocess_zimage_t2i"
  },
  "sampler": {
    "type": "grid",
    "steps": 30,
    "shift": "linear",
    "transition": {
      "type": "euler",
      "prediction": { "type": "cfg", "scale": 4.0, "renorm": true }
    }
  },
  "processor": {
    "task": "t2i",
    "preset": "zimage"
  },
  "launch": {
    "type": "inference",
    "devices": 4,
    "preprocess_config": "./examples/t2i/zimage/preprocess.jsonc"
  }
}
