{
  "$schema": "../../../schema/inference.schema.json",
  "report": {
    "path": "./demo/inference_flux_t2i",
    "previews": true,
    "records": false
  },
  "hsdp_shard_dim": 1,
  "model": {
    "arch": "flux1",
    "type": "base"
  },
  "dataset": {
    "type": "cache",
    "path": "./demo/preprocess_flux_t2i"
  },
  "sampler": {
    "steps": 20,
    "shift": {
      "type": "linear"
    }
  },
  "processor": {
    "task": "t2i",
    "preset": "flux1"
  },
  "launch": {
    "type": "inference",
    "devices": 4,
    "preprocess_config": "examples/t2i/flux1/preprocess.jsonc"
  }
}
