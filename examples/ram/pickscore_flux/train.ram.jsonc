{
  "$schema": "../../../schema/ram.schema.json",

  // RAM (Reinforce Adjoint Matching) FLUX.1-dev PickScore run -- EXPERIMENTAL.
  // RAM's official repo has NO FLUX experiments: it is built for SD3.5-M and
  // samples endpoints with TRUE CFG=2.0. FLUX is guidance-distilled and does not
  // take a true CFG pass, so this config keeps the default guidance scale 1.0
  // (distilled guidance embedding in the adapter). This deviates from the paper
  // and is provided for exploration only -- expect it to behave differently
  // from the SD3.5-M runs.
  // Reuses the shared ./data/pickscore_flux caches produced by ../../grpo/pickscore_flux.
  "checkpoint_root": "$auto",
  "auto_resume": true,
  "seed_checkpoint_dir": "/dev/shm/flow-control/seed_flux_pickscore_ram",
  "experiment_name": "flux_pickscore_ram",

  "rollout_storage_device": "device",

  // 12 x 4 = 48 unique prompts, x24 rollouts = 1152 rollouts.
  "num_prompts_per_epoch": 48,
  "num_rollouts_per_prompt": 24,
  "num_inner_epochs": 1,
  // 1152 rollouts x K=8 loss targets -> 9216 items, 1 optimizer update per epoch.
  "train_batch_size": 9216,
  "train_timesteps": {
    "type": "continuous",
    "count": 8,
    // RAM draws grid ranks with weight (1 - i/n)^alpha but trains at the scheduler's
    // shifted sigma at that rank: shift = the linear FLUX.1 shift at 512x512
    // (1024 tokens, mu = 0.63, e^mu = 1.8776) applied after the draw.
    "weighting": { "type": "power_law", "alpha": 1.0, "shift": 1.8776 },
  },

  "objective": {
    "type": "ram",
    "reward_multiplier": 1000.0,
    "adv_clip_max": null,
  },
  "clip_grad_norm": 0.0,

  "train_epochs": 500,
  "checkpoint_interval": 10,
  "validation_epochs": 10,
  "validation_variants": ["ema"],
  "max_checkpoints": 10,
  "validation_log_images": 64,

  "model": {
    "arch": "flux1",
    "type": "base",
    "variants": {
      "default": { "type": "lora", "rank": 64, "alpha": 128, "init": "gaussian" },
      "ema": { "type": "ema", "of": "default", "decay": 0.9, "warmup": "standard" },
      "old": {
        "type": "ema",
        "of": "default",
        "every": "epoch",
        "decay": 0.9,
        "warmup": { "type": "linear_ramp", "flat_steps": 0, "ramp_rate": 0.01 },
      },
      "ref": { "type": "alias", "of": "base" },
    },
  },

  "dataset": {
    "type": "cache",
    "path": "./data/pickscore_flux/train",
  },

  "train_predictor": "model",

  "rollout": {
    "type": "pointwise",
    "sampler": {
      // FLUX distilled: no true CFG -> no cfg node (vs RAM's SD3 CFG 2.0).
      "type": "grid",
      "steps": 20,
      "shift": "linear",
      "transition": { "type": "euler", "eta": 0.0 },
    },
    "reward": {
      "type": "pickscore",
    },
  },

  "advantage": {
    "type": "per_prompt",
    "use_global_std": true,
  },

  "optimizer_config": {
    "class_name": "AdamW",
    "lr": 3e-4,
    "weight_decay": 1e-4,
    "betas": [0.9, 0.99],
  },

  "scheduler_config": {
    "class_name": "ConstantLR",
    "factor": 1.0,
  },

  "validation_dataset": {
    "type": "cache",
    "path": "./data/pickscore_flux/validation_grpo",
    "limit": 256,
  },

  "validation_sampler": { "type": "grid", "steps": 28, "shift": "linear" },

  "processor": {
    "task": "t2i",
    "preset": "flux1",
    "default_resolution": [512, 512],
  },

  "launch": {
    "type": "ram",
    "devices": 8,
    "generate_dcp_seed": true,
  },
}
