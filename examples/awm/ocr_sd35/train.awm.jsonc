{
  "$schema": "../../../schema/awm.schema.json",

  // AWM SD3.5-Medium OCR reproduction of the public author config.
  // Ref: scxue/advantage_weighted_matching config/dgx_awm.py:ocr_sd3_no_cfg_1node
  //   (14-step second-order SA-Solver / 40-step ODE eval, cfg 1.0,
  //    stochasticity 0.4 on t=[0.3,0.9], G=24, 1728 endpoints,
  //    train_timesteps 6, beta 3e-3, ema_beta 1, ghuber p=0.25).
  // Reuses the shared ./data/ocr_sd35 caches produced by ../../grpo/ocr_sd35.
  "checkpoint_root": "$auto",
  "auto_resume": true,
  "seed_checkpoint_dir": "/dev/shm/flow-control/seed_sd35_ocr_awm",
  "experiment_name": "sd35_ocr_awm",

  "gradient_checkpointing": false,
  "torch_compile": {
    "backend": "inductor",
    "mode": "default",
    "fullgraph": false,
    "dynamic": false,
    // SD3 shares forward code across block/LoRA/grad variants; 8 falls back to eager.
    "recompile_limit": 16,
  },

  "train_micro_batch_size": 4,

  "rollout_storage_device": "device",

  // 9 x 8 = 72 unique prompts, x24 rollouts = 1728 endpoints.
  "num_prompts_per_epoch": 72,
  "num_rollouts_per_prompt": 24,
  "num_inner_epochs": 1,
  // 1728 endpoints x 6 timesteps -> 10368 items, one optimizer update per epoch.
  "train_batch_size": 10368,
  "train_timesteps": {
    "type": "grid",
    "count": 6,
    "window": 0.9,
    "exclude_first": true,
    "mode": "stratified",
  },

  "objective": {
    "type": "awm",
    "beta": 0.003,
    "ema_beta": 1.0,
    "advantage_max": 1.0,
    "adv_clip_max": 5.0,
    "clip_range": 1.0,
    "weighting": "ghuber",
    "ghuber_power": 0.25,
    "kl_weight": "uniform",
    "kl_ema_weight": "uniform",
    "off_policy": false,
  },
  "clip_grad_norm": 1.0,

  "train_epochs": 500,
  "checkpoint_interval": 20,
  "validation_epochs": 20,
  "validation_variants": ["ema", "default"],
  "validation_log_images": 16,
  "max_checkpoints": 5,

  "model": {
    "arch": "sd3",
    "type": "base",
    "micro_batch_size": 4,
    "variants": {
      "default": { "type": "lora", "rank": 32, "alpha": 64, "init": "gaussian" },
      "ema": { "type": "ema", "of": "default", "decay": 0.99, "warmup": "standard" },
      "old": {
        "type": "ema",
        "of": "default",
        "every": "epoch",
        "decay": 0.3,
        "warmup": { "type": "linear_ramp", "flat_steps": 0, "ramp_rate": 0.001 },
      },
      "ref": { "type": "alias", "of": "base" },
    },
  },

  "dataset": {
    "type": "cache",
    "path": "./data/ocr_sd35/train",
  },

  "train_predictor": "model",

  "rollout": {
    "type": "pointwise",
    "sampler": {
      "type": "sa",
      "steps": 14,
      "shift": { "type": "constant", "shift_value": 3.0, "diffusers_grid": 1000 },
      "eta": 0.4,
      "stochasticity_start": 0.3,
      "stochasticity_end": 0.9,
    },
    "reward": {
      "type": "ocr",
    },
  },

  "advantage": {
    "type": "per_prompt",
    "use_global_std": true,
  },

  "optimizer_config": {
    "class_name": "AdamW",
    "lr": 3e-4,
    "weight_decay": 1e-4,
  },

  "scheduler_config": {
    "class_name": "ConstantLR",
    "factor": 1,
  },

  "validation_dataset": {
    "type": "cache",
    "path": "./data/ocr_sd35/validation",
  },

  "validation_sampler": {
    "type": "grid",
    "steps": 40,
    "shift": { "type": "constant", "shift_value": 3.0, "diffusers_grid": 1000 },
  },

  "processor": {
    "task": "t2i",
    "preset": "sd35_medium",
    "default_resolution": [512, 512],
  },

  "launch": {
    "type": "awm",
    "devices": 4,
    "generate_dcp_seed": true,
    // "preprocess_config": [
    //   "examples/grpo/ocr_sd35/preprocess.jsonc",
    //   "examples/grpo/ocr_sd35/validation.preprocess.jsonc",
    // ],
  },
}
