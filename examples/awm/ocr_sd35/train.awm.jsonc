{
  "$schema": "../../../schema/awm.schema.json",

  // AWM SD3.5-Medium OCR reproduction of the public author config.
  // Ref: scxue/advantage_weighted_matching config/dgx_awm.py:ocr_sd3_no_cfg_1node
  //   (14-step second-order SA-Solver / 40-step ODE eval, cfg 1.0,
  //    stochasticity 0.4 on t=[0.3,0.9], G=24, 1728 endpoints,
  //    train_timesteps 6, beta 3e-3, ema_beta 1, ghuber p=0.25).
  // Reuses the shared ./data/ocr_sd35 caches produced by ../../grpo/ocr_sd35.
  "checkpoint_root": "$auto",
  "auto_resume": true,
  "seed_checkpoint_dir": "/dev/shm/flow-control/seed_sd35_ocr_awm",
  "experiment_name": "sd35_ocr_awm",

  "gradient_checkpointing": false,
  "torch_compile": {
    "backend": "inductor",
    "mode": "default",
    "fullgraph": false,
    "dynamic": false,
    // SD3 shares forward code across block/LoRA/grad variants; 8 falls back to eager.
    "recompile_limit": 16,
  },

  "rollout_micro_batch_size": 4,
  "train_micro_batch_size": 4,
  "validation_micro_batch_size": 4,

  "rollout_storage_device": "device",
  "precompute_aux_model_outputs": true,

  // 9 x 8 = 72 unique prompts, x24 rollouts = 1728 endpoints.
  "num_batches_per_epoch": 9,
  "num_prompts_per_batch": 8,
  "num_rollouts_per_prompt": 24,
  "num_inner_epochs": 1,
  // 1728 endpoints x 6 timesteps -> 10368 items, one optimizer update per epoch.
  "train_batch_size": 10368,
  "num_train_timesteps": 6,
  "timestep_fraction": 0.9,
  "train_timestep_sampling": "discrete_wo_init",

  "beta": 0.003,
  "ema_beta": 1.0,
  "advantage_max": 1.0,
  "adv_clip_max": 5.0,
  "clip_range": 1.0,
  "weighting": "ghuber",
  "ghuber_power": 0.25,
  "kl_weight": "uniform",
  "kl_ema_weight": "uniform",
  "off_policy": false,
  "clip_grad_norm": 1.0,

  "train_epochs": 500,
  "checkpoint_interval": 20,
  "validation_epochs": 20,
  "validation_non_ema": true,
  "validation_log_images": 16,
  "max_checkpoints": 5,

  "model": {
    "arch": "sd3",
    "type": "base",
    "peft_lora_rank": 32,
    "peft_lora_config": {
      "r": 32,
      "lora_alpha": 64,
      "init_lora_weights": "gaussian",
      "target_modules": [
        "attn.to_q",
        "attn.to_k",
        "attn.to_v",
        "attn.to_out.0",
        "attn.add_q_proj",
        "attn.add_k_proj",
        "attn.add_v_proj",
        "attn.to_add_out",
      ],
    },
  },

  "dataset": {
    "type": "pickle_directory",
    "path": "./data/ocr_sd35/train",
  },

  "rollout_sampler": {
    "steps": 14,
    "sigma_schedule": "diffusers_flow",
    "shift": { "type": "constant", "shift_value": 3.0 },
    "solver": {
      "type": "sa",
      "eta": 0.4,
      "stochasticity_start": 0.3,
      "stochasticity_end": 0.9,
    },
  },

  "ema_old": {
    "decay": 0.3,
    "warmup": { "type": "linear_ramp", "flat_steps": 0, "ramp_rate": 0.001 },
    "interval": 1,
  },

  "ema": {
    "decay": 0.99,
    "warmup": { "type": "standard" },
    "interval": 1,
  },

  "reward": {
    "type": "ocr",
  },

  "advantage": {
    "type": "per_prompt",
    "use_global_std": true,
  },

  "optimizer_config": {
    "class_name": "AdamW",
    "lr": 3e-4,
    "weight_decay": 1e-4,
  },

  "scheduler_config": {
    "class_name": "ConstantLR",
    "factor": 1,
  },

  "validation_dataset": {
    "type": "pickle_directory",
    "path": "./data/ocr_sd35/validation",
  },

  "validation_sampler": {
    "steps": 40,
    "sigma_schedule": "diffusers_flow",
    "shift": { "type": "constant", "shift_value": 3.0 },
  },

  "processor": {
    "task": "t2i",
    "preset": "sd35_medium",
    "default_resolution": [512, 512],
  },

  "launch": {
    "type": "awm",
    "devices": 4,
    "generate_dcp_seed": true,
    // "preprocess_config": [
    //   "examples/grpo/ocr_sd35/preprocess.jsonc",
    //   "examples/grpo/ocr_sd35/validation.preprocess.jsonc",
    // ],
  },
}
