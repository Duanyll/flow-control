{
  "$schema": "../../../schema/awm.schema.json",

  // AWM (Advantage Weighted Matching) SD3.5-Medium PickScore reproduction.
  // Ref: scxue/advantage_weighted_matching config/dgx_awm.py:pickscore_sd3_no_cfg_1node
  //   (14/40 steps, cfg 1.0, DETERMINISTIC noise_level 0.0, G=24, train_timesteps 6,
  //    beta 1e-4, ema_beta 1, ghuber p=0.25, time_type `discrete`, off-policy off).
  // Reuses the shared ./data/pickscore_sd35 caches produced by ../../grpo/pickscore_sd35.
  "checkpoint_root": "$auto",
  "auto_resume": true,
  "seed_checkpoint_dir": "/dev/shm/flow-control/seed_sd35_pickscore_awm",
  "experiment_name": "sd35_pickscore_awm",

  "gradient_checkpointing": false,
  "torch_compile": {
    "backend": "inductor",
    "mode": "default",
    "fullgraph": false,
    "dynamic": false,
    // SD3 shares forward code across block/LoRA/grad variants; 8 falls back to eager.
    "recompile_limit": 16,
  },

  "train_micro_batch_size": 4,

  "rollout_storage_device": "device",

  // 6 x 8 = 48 unique prompts, x24 rollouts = 1152 rollouts.
  "num_prompts_per_epoch": 48,
  "num_rollouts_per_prompt": 24,
  "num_inner_epochs": 1,
  // 1152 rollouts x 6 training timesteps -> 6912 items, 1 optimizer update per epoch.
  "train_batch_size": 6912,
  "train_timesteps": {
    "type": "grid",
    "count": 6,
    "window": 0.9,
    // PickScore uses the `discrete` grid (includes the pure-noise init index 0).
    "exclude_first": false,
    "mode": "stratified",
  },

  "objective": {
    "type": "awm",
    "beta": 0.0001,
    "ema_beta": 1.0,
    "advantage_max": 1.0,
    "adv_clip_max": 5.0,
    "clip_range": 1.0,
    "weighting": "ghuber",
    "ghuber_power": 0.25,
    "kl_weight": "uniform",
    "kl_ema_weight": "uniform",
    "off_policy": false,
  },
  "clip_grad_norm": 1.0,

  "train_epochs": 500,
  "checkpoint_interval": 10,
  "validation_epochs": 10,
  "validation_variants": ["ema"],
  "max_checkpoints": 10,

  "model": {
    "arch": "sd3",
    "type": "base",
    "micro_batch_size": 4,
    "variants": {
      "default": { "type": "lora", "rank": 32, "alpha": 64 },
      "ema": { "type": "ema", "of": "default", "decay": 0.99, "warmup": "standard" },
      "old": {
        "type": "ema",
        "of": "default",
        "every": "epoch",
        "decay": 0.3,
        "warmup": { "type": "linear_ramp", "flat_steps": 0, "ramp_rate": 0.001 },
      },
      "ref": { "type": "alias", "of": "base" },
    },
  },

  "dataset": {
    "type": "cache",
    "path": "./data/pickscore_sd35/train",
  },

  "train_predictor": "model",

  "rollout_sampler": {
    // eta 0.0 -> deterministic ODE rollout for PickScore.
    "type": "grid",
    "steps": 14,
    "shift": 3.0,
    "transition": { "type": "euler", "eta": 0.0 },
  },

  "reward": {
    "type": "pickscore",
  },

  "advantage": {
    "type": "per_prompt",
    "use_global_std": true,
  },

  "optimizer_config": {
    "class_name": "AdamW",
    "lr": 3e-4,
    "weight_decay": 1e-4,
  },

  "scheduler_config": {
    "class_name": "ConstantLR",
    "factor": 1,
  },

  "validation_dataset": {
    "type": "cache",
    "path": "./data/pickscore_sd35/validation",
  },

  "validation_sampler": { "type": "grid", "steps": 40, "shift": 3.0 },

  "processor": {
    "task": "t2i",
    "preset": "sd35_medium",
    "default_resolution": [512, 512],
  },

  "launch": {
    "type": "awm",
    "devices": 8,
    "generate_dcp_seed": true,
    // "preprocess_config": [
    //   "examples/grpo/pickscore_sd35/preprocess.jsonc",
    //   "examples/grpo/pickscore_sd35/validation.preprocess.jsonc",
    // ],
  },
}
