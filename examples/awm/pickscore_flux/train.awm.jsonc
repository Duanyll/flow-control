{
  "$schema": "../../../schema/awm.schema.json",

  // AWM (Advantage Weighted Matching) FLUX.1-dev PickScore run.
  // The AWM paper reports FLUX results, but the released repo ships only SD3.5-M
  // configs; the AWM knobs below follow dgx_awm.py and the FLUX model/sampler
  // blocks follow this repo's examples/{grpo,nft}/pickscore_flux. FLUX is
  // guidance-distilled, so rollouts use the default guidance (cfg scale 1.0;
  // the distilled guidance embedding lives in the adapter) instead of AWM's
  // SD3 true-CFG-off setting.
  // Reuses the shared ./data/pickscore_flux caches produced by ../../grpo/pickscore_flux.
  "checkpoint_root": "$auto",
  "auto_resume": true,
  "seed_checkpoint_dir": "/dev/shm/flow-control/seed_flux_pickscore_awm",
  "experiment_name": "flux_pickscore_awm",

  "rollout_storage_device": "device",

  // 12 x 4 = 48 unique prompts, x24 rollouts = 1152 rollouts.
  "num_prompts_per_epoch": 48,
  "num_rollouts_per_prompt": 24,
  "num_inner_epochs": 1,
  // 1152 rollouts x 6 training timesteps -> 6912 items, 1 optimizer update per epoch.
  "train_batch_size": 6912,
  "train_timesteps": {
    "type": "grid",
    "count": 6,
    "window": 0.9,
    "exclude_first": true,
    "mode": "stratified",
  },

  "objective": {
    "type": "awm",
    "beta": 0.0001,
    "ema_beta": 1.0,
    "advantage_max": 1.0,
    "adv_clip_max": 5.0,
    "clip_range": 1.0,
    "weighting": "ghuber",
    "ghuber_power": 0.25,
    "kl_weight": "uniform",
    "kl_ema_weight": "uniform",
    "off_policy": false,
  },
  "clip_grad_norm": 1.0,

  "train_epochs": 500,
  "checkpoint_interval": 10,
  "validation_epochs": 10,
  "validation_variants": ["ema"],
  "max_checkpoints": 10,
  "validation_log_images": 64,

  "model": {
    "arch": "flux1",
    "type": "base",
    "variants": {
      "default": { "type": "lora", "rank": 64, "alpha": 128, "init": "gaussian" },
      "ema": { "type": "ema", "of": "default", "decay": 0.99, "warmup": "standard" },
      "old": {
        "type": "ema",
        "of": "default",
        "every": "epoch",
        "decay": 0.3,
        "warmup": { "type": "linear_ramp", "flat_steps": 0, "ramp_rate": 0.001 },
      },
      "ref": { "type": "alias", "of": "base" },
    },
  },

  "dataset": {
    "type": "cache",
    "path": "./data/pickscore_flux/train",
  },

  "train_predictor": "model",

  "rollout_sampler": {
    "type": "grid",
    "steps": 14,
    "shift": "linear",
    "transition": { "type": "euler", "eta": 0.4 },
  },

  "reward": {
    "type": "pickscore",
  },

  "advantage": {
    "type": "per_prompt",
    "use_global_std": false,
  },

  "optimizer_config": {
    "class_name": "AdamW",
    "lr": 3e-4,
    "weight_decay": 1e-4,
  },

  "scheduler_config": {
    "class_name": "ConstantLR",
    "factor": 1.0,
  },

  "validation_dataset": {
    "type": "cache",
    "path": "./data/pickscore_flux/validation_grpo",
    "limit": 256,
  },

  "validation_sampler": { "type": "grid", "steps": 28, "shift": "linear" },

  "processor": {
    "task": "t2i",
    "preset": "flux1",
    "default_resolution": [512, 512],
  },

  "launch": {
    "type": "awm",
    "devices": 8,
    "generate_dcp_seed": true,
  },
}
