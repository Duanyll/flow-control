{
  "$schema": "../../../schema/grpo.schema.json",

  // Flow-GRPO SD3.5-Medium GenEval, no-CFG "fast" regime (CFG distillation).
  // Ref: ~/flow_grpo config/grpo.py:geneval_sd3_fast_nocfg + CPS (noise_level 0.8),
  // trajectory-window training. Faster than the faithful config; diverges from the
  // paper table but is Flow-GRPO's current recommendation.
  "checkpoint_root": "$auto",
  "auto_resume": true,
  "seed_checkpoint_dir": "/dev/shm/flow-control/seed_sd35_geneval_grpo_nocfg",
  "experiment_name": "sd35_geneval_grpo_nocfg",

  "train_micro_batch_size": 4,

  // Per-epoch sample budget: 6 x 8 = 48 unique prompts, x24 rollouts = 1152 rollouts.
  "num_prompts_per_epoch": 48,
  "num_rollouts_per_prompt": 24,
  "num_inner_epochs": 1,
  // train a 3-step window per rollout -> 1152 x 3 = 3456 items, /2 optimizer updates.
  "train_batch_size": 1728,

  "clip_grad_norm": 1.0,
  "clip_range": 1e-4,
  "kl_beta": 0.04,

  "train_epochs": 500,
  "checkpoint_interval": 10,
  "validation_epochs": 10,
  "validation_variants": ["ema"],
  "max_checkpoints": 10,

  "model": {
    "arch": "sd3",
    "type": "base",
    "micro_batch_size": 4,
    "variants": {
      "default": { "type": "lora", "rank": 32, "alpha": 64, "init": "gaussian" },
      "ema": { "type": "ema", "of": "default", "decay": 0.9, "warmup": "standard" },
      "ref": { "type": "alias", "of": "base" },
    },
  },

  "dataset": {
    "type": "cache",
    "path": "./data/geneval_sd35/train",
  },

  "train_predictor": "model",

  "rollout": {
    "type": "pointwise",
    // Random 3-step recorded SDE window; omit "window_range" -> anywhere in (0, steps-1).
    "sampler": {
      "type": "sde_window_grid",
      "steps": 10,
      "size": 3,
      "eta": 0.8,
      "shift": 3.0,
      "transition": { "type": "cps", "eta": 0.0 },
    },
    "reward": {
      "type": "geneval",
      "checkpoint_path": "./data/mask2former_swin-s-p4-w7-224_coco.pth",
      "scoring_mode": "reward_server",
    },
  },

  "advantage": {
    "type": "per_prompt",
    "use_global_std": true,
  },

  "optimizer_config": {
    "class_name": "AdamW",
    "lr": 3e-4,
    "weight_decay": 1e-4,
  },

  "scheduler_config": {
    "class_name": "ConstantLR",
    "factor": 1,
  },

  "validation_dataset": {
    "type": "cache",
    "path": "./data/geneval_sd35/validation",
  },

  "validation_sampler": { "type": "grid", "steps": 40, "shift": 3.0 },

  "processor": {
    "task": "t2i",
    "preset": "sd35_medium",
    "default_resolution": [512, 512],
  },

  "launch": {
    "type": "grpo",
    "devices": 8,
    "generate_dcp_seed": true,
  },
}
