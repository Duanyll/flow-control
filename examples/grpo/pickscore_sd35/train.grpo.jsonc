{
  "$schema": "../../../schema/grpo.schema.json",

  // Flow-GRPO SD3.5-Medium PickScore reproduction (faithful, true CFG).
  // Ref: ~/flow_grpo config/grpo.py:pickscore_sd3 (cfg 4.5, SDE eta 0.7, 10/40 steps, KL 0.01).
  "checkpoint_root": "$auto",
  "auto_resume": true,
  "seed_checkpoint_dir": "/dev/shm/flow-control/seed_sd35_pickscore_grpo",
  "experiment_name": "sd35_pickscore_grpo",

  "train_micro_batch_size": 4,

  "num_prompts_per_epoch": 48,
  "num_rollouts_per_prompt": 24,
  "num_inner_epochs": 1,
  "train_batch_size": 5760,

  "clip_grad_norm": 1.0,
  "clip_range": 1e-4,
  "kl_beta": 0.01,

  "train_epochs": 500,
  "checkpoint_interval": 10,
  "validation_epochs": 10,
  "validation_variants": ["ema"],
  "max_checkpoints": 10,

  "model": {
    "arch": "sd3",
    "type": "base",
    "micro_batch_size": 4,
    "variants": {
      "default": { "type": "lora", "rank": 32, "alpha": 64 },
      "ema": { "type": "ema", "of": "default", "decay": 0.9, "warmup": "standard" },
      "ref": { "type": "alias", "of": "base" },
    },
  },

  "dataset": {
    "type": "cache",
    "path": "./data/pickscore_sd35/train",
  },

  "train_predictor": {"type": "cfg", "scale": 4.5},

  "rollout_sampler": {
    "type": "grid",
    "steps": 10,
    "shift": 3.0,
    "transition": {
      "type": "euler",
      "eta": 0.7,
      "prediction": { "type": "cfg", "scale": 4.5 },
    },
  },

  "reward": {
    "type": "pickscore",
  },

  "advantage": {
    "type": "per_prompt",
    "use_global_std": true,
  },

  "optimizer_config": {
    "class_name": "AdamW",
    "lr": 3e-4,
    "weight_decay": 1e-4,
  },

  "scheduler_config": {
    "class_name": "ConstantLR",
    "factor": 1,
  },

  "validation_dataset": {
    "type": "cache",
    "path": "./data/pickscore_sd35/validation",
  },

  "validation_sampler": {
    "type": "grid",
    "steps": 40,
    "shift": 3.0,
    "transition": {
      "type": "euler",
      "prediction": { "type": "cfg", "scale": 4.5 },
    },
  },

  "processor": {
    "task": "t2i",
    "preset": "sd35_medium",
    "default_resolution": [512, 512],
  },

  "launch": {
    "type": "grpo",
    "devices": 8,
    "generate_dcp_seed": true,
    // "preprocess_config": [
    //   "examples/grpo/pickscore_sd35/preprocess.jsonc",
    //   "examples/grpo/pickscore_sd35/validation.preprocess.jsonc",
    // ],
  },
}
