{
  "$schema": "../../../schema/grpo.schema.json",

  "checkpoint_root": "$auto",
  "auto_resume": true,
  "seed_checkpoint_dir": "/dev/shm/flow-control/seed",
  "experiment_name": "flux_pickscore_grpo_fast",

  "num_prompts_per_epoch": 48,
  "num_rollouts_per_prompt": 24,
  "num_inner_epochs": 1,
  "train_batch_size": 1728,

  "clip_grad_norm": 1.0,
  "clip_range": 1e-5,
  "kl_beta": 0.0,

  "train_epochs": 500,
  "checkpoint_interval": 10,
  "validation_epochs": 10,
  "validation_variants": ["ema"],
  "max_checkpoints": 10,

  // Score a larger validation set (256 prompts) for a more accurate online
  // reward metric, but only push the first 64 image samples to trackio so the
  // db stays small. The mean reward is still computed over all 256.
  "validation_log_images": 64,

  "model": {
    "arch": "flux1",
    "type": "base",
    "variants": {
      "default": { "type": "lora", "rank": 64, "alpha": 128, "init": "gaussian" },
      "ema": { "type": "ema", "of": "default", "decay": 0.9, "warmup": "standard" },
    },
  },

  "dataset": {
    "type": "cache",
    "path": "./data/pickscore_flux/train",
  },

  "train_predictor": "model",

  "rollout_sampler": {
    "type": "sde_window_grid",
    "steps": 6,
    "size": 3,
    "window_range": [0, 3],
    "eta": 0.8,
    "shift": "linear",
    "transition": { "type": "cps", "eta": 0.0 },
  },

  "reward": {
    "type": "pickscore",
  },

  "advantage": {
    "type": "per_prompt",
    "use_global_std": false,
  },

  "optimizer_config": {
    "class_name": "AdamW",
    "lr": 3e-4,
    "weight_decay": 1e-4,
  },

  "scheduler_config": {
    "class_name": "ConstantLR",
    "factor": 1.0,
  },

  "validation_dataset": {
    "type": "cache",
    "path": "./data/pickscore_flux/validation_grpo",
    "limit": 256,
  },

  "validation_sampler": { "type": "grid", "steps": 28, "shift": "linear" },

  "processor": {
    "task": "t2i",
    "preset": "flux1",
    "default_resolution": [512, 512],
  },

  "launch": {
    "type": "grpo",
    "devices": 8,
    "generate_dcp_seed": true,
  },
}
