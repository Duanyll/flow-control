{
  "$schema": "../../../schema/grpo.schema.json",

  "checkpoint_root": "$auto",
  "auto_resume": true,
  "seed_checkpoint_dir": "/dev/shm/flow-control/seed",
  "experiment_name": "flux_ocr_grpo_debug",

  "num_prompts_per_epoch": 4,
  "num_rollouts_per_prompt": 4,
  "num_inner_epochs": 1,
  "train_batch_size": 40,

  "clip_grad_norm": 1.0,
  "clip_range": 1e-4,
  "kl_beta": 0.04,

  "train_epochs": 20,
  "checkpoint_interval": 5,
  "validation_epochs": 5,
  "validation_variants": ["ema"],

  "model": {
    "arch": "flux1",
    "type": "base",
    "guidance": 3.5,
    "variants": {
      "default": { "type": "lora", "rank": 64, "alpha": 128, "init": "gaussian" },
      "ema": { "type": "ema", "of": "default", "decay": 0.9, "warmup": "standard" },
      "ref": { "type": "alias", "of": "base" },
    },
  },

  "dataset": {
    "type": "cache",
    "path": "./data/ocr_flux_grpo/train",
  },

  "train_predictor": "model",

  "rollout_sampler": {
    "type": "grid",
    "steps": 6,
    "shift": "linear",
    "transition": { "type": "euler", "eta": 0.7 },
  },

  "reward": {
    "type": "ocr",
  },

  "advantage": {
    "type": "per_prompt",
    "use_global_std": true,
  },

  "optimizer_config": {
    "class_name": "AdamW",
    "lr": 3e-4,
    "weight_decay": 1e-4,
  },

  "scheduler_config": {
    "class_name": "ConstantLR",
    "factor": 1.0,
  },

  "validation_dataset": {
    "type": "cache",
    "path": "./data/ocr_flux_grpo/validation",
    "limit": 8,
  },

  "validation_sampler": { "type": "grid", "steps": 28, "shift": "linear" },

  "processor": {
    "task": "t2i",
    "preset": "flux1",
    "default_resolution": [512, 512],
  },

  "launch": {
    "type": "grpo",
    "devices": 8,
    "generate_dcp_seed": true,
  },
}
