{
  "$schema": "../../../schema/nft.schema.json",

  "checkpoint_root": "$auto",
  "auto_resume": true,
  "seed_checkpoint_dir": "/dev/shm/flow-control/seed",
  "experiment_name": "flux_nft_demo_debug",

  "num_prompts_per_epoch": 4,
  "num_rollouts_per_prompt": 4,
  "num_inner_epochs": 1,
  "train_batch_size": 8,
  
  "train_timesteps": {
    "type": "grid",
    "count": 2,
    "fraction": 0.7,
  },
  "objective": {
    "type": "nft",
    "beta": 1.0,
    "adv_clip_max": 5.0,
    "kl_beta": 0.0,
  },
  "clip_grad_norm": 1.0,

  "train_epochs": 20,
  "checkpoint_interval": 5,
  "validation_epochs": 5,
  "validation_variants": ["ema"],

  "model": {
    "arch": "flux1",
    "type": "base",
    "variants": {
      "default": { "type": "lora", "rank": 64, "alpha": 128, "init": "gaussian" },
      "ema": { "type": "ema", "of": "default", "decay": 0.9, "warmup": "standard" },
      "old": {
        "type": "ema",
        "of": "default",
        "every": "epoch",
        "decay": 0.5,
        "warmup": { "type": "linear_ramp", "flat_steps": 0, "ramp_rate": 0.001 },
      },
    },
  },

  "dataset": {
    "type": "cache",
    "path": "./data/pickscore_flux/train",
  },

  "train_predictor": "model",

  "rollout": {
    "type": "pointwise",
    "sampler": { "type": "grid", "steps": 8, "shift": "linear" },
    "reward": {
      "type": "pickscore"
    },
  },

  "advantage": {
    "type": "per_prompt",
    "use_global_std": false
  },

  "optimizer_config": {
    "class_name": "AdamW",
    "lr": 3e-4,
    "weight_decay": 1e-4,
  },

  "scheduler_config": {
    "class_name": "ConstantLR",
    "factor": 1,
  },

  "validation_dataset": {
    "type": "cache",
    "path": "./data/pickscore_flux/validation",
    "limit": 8
  },

  "validation_sampler": { "type": "grid", "steps": 28, "shift": "linear" },

  "processor": {
    "task": "t2i",
    "preset": "flux1",
    "default_resolution": [384, 384],
  },

  "launch": {
    "type": "nft",
    "devices": 4,
    // "generate_dcp_seed": true,
  },
}
