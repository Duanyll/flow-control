{
  "$schema": "../../../schema/inference.schema.json",
  "report": {
    "path": "./demo/inference_qwen_tie",
    "previews": true,
    "records": false
  },
  "hsdp_shard_dim": 1,
  "model": {
    "arch": "qwen",
    "type": "edit"
  },
  "dataset": {
    "type": "cache",
    "path": "./demo/preprocess_qwen_tie"
  },
  "sampler": {
    "steps": 28,
    "guidance": { "type": "cfg", "scale": 4.0, "renorm": true },
    "shift": {
      "type": "linear",
      "max_image_seq_len": 8192,
      "max_shift": 0.9
    }
  },
  "processor": {
    "task": "tie",
    "preset": "qwen_image_edit"
  },
  "launch": {
    "type": "inference",
    "devices": 4
  }
}
