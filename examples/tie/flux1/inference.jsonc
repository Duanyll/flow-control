{
  "$schema": "../../../schema/inference.schema.json",
  "report": {
    "path": "./demo/inference_flux_tie",
    "previews": true,
    "records": false
  },
  "hsdp_shard_dim": 1,
  "model": {
    "arch": "flux1",
    "type": "kontext"
  },
  "dataset": {
    "type": "cache",
    "path": "./demo/preprocess_flux_tie"
  },
  "sampler": {
    "steps": 20,
    "shift": {
      "type": "linear"
    }
  },
  "processor": {
    "task": "tie",
    "preset": "flux1"
  },
  "launch": {
    "type": "inference",
    "devices": 4
  }
}
