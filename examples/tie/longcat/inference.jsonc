{
  "$schema": "../../../schema/inference.schema.json",
  "report": {
    "path": "./demo/inference_longcat_tie",
    "previews": true,
    "records": false
  },
  "hsdp_shard_dim": 1,
  "model": { "arch": "longcat", "type": "edit" },
  "dataset": {
    "type": "cache",
    "path": "./demo/preprocess_longcat_tie"
  },
  "sampler": {
    "type": "grid",
    "steps": 50,
    "shift": "linear",
    "transition": {
      "type": "euler",
      "prediction": { "type": "cfg", "scale": 4.5, "renorm": true }
    }
  },
  "processor": {
    "task": "tie",
    "preset": "longcat_image_edit"
  },
  "launch": {
    "type": "inference",
    "devices": 4,
    "preprocess_config": "examples/tie/longcat/preprocess.jsonc",
    "env": {
      "NCCL_CUMEM_HOST_ENABLE": "0",
      "NCCL_P2P_LEVEL": "SYS"
    }
  }
}
