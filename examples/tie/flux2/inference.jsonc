{
  "$schema": "../../../schema/inference.schema.json",
  "seed_checkpoint_dir": "/dev/shm/flow-control/seed",
  "report": {
    "path": "./demo/inference_flux2_tie",
    "previews": true,
    "records": false
  },
  "hsdp_shard_dim": 2,
  "model": {
    "arch": "flux2",
    "type": "base"
  },
  "dataset": {
    "type": "cache",
    "path": "./demo/preprocess_flux2_tie"
  },
  "sampler": {
    "steps": 28,
    "shift": {
      "type": "flux2"
    }
  },
  "processor": {
    "task": "tie",
    "preset": "flux2",
    "resize_mode": "multiple_of",
    "total_pixels": 1048576
  },
  "launch": {
    "type": "inference",
    "devices": 4,
    "generate_dcp_seed": true,
    "env": {
      "NCCL_CUMEM_HOST_ENABLE": "0",
      "NCCL_P2P_LEVEL": "SYS"
    }
  }
}
